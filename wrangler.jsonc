{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "field-data",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DOMAIN": "field-data.mohamedbangura.workers.dev",
    "SYSADMIN_EMAIL": "admin@fielddata.quantixsl.com",
    "PGDATABASE": "postgres",
    "PGSSLMODE": "require",
    "PGOPTIONS": "-c search_path=field_data,extensions,public",
    "DB_POOL_SIZE": "3",
    "SUPABASE_S3_ENDPOINT": "https://zzhppomwnjlwkbmythqw.storage.supabase.co/storage/v1/s3",
    "SUPABASE_STORAGE_BUCKET": "field-data",
    "SUPABASE_REGION": "eu-west-2",
    "FORM_COMPILER_MAX_BYTES": "26214400",
    "EMAIL_FROM": "admin@fielddata.quantixsl.com",
    "EMAIL_HOST": "smtp.hostinger.com",
    "EMAIL_PORT": "465",
    "EMAIL_SECURE": "true",
    "EMAIL_IGNORE_TLS": "false",
    "OIDC_ENABLED": "false",
    "OIDC_ISSUER_URL": "",
    "OIDC_CLIENT_ID": "",
    "SENTRY_DSN_FRONTEND": "",
    // Overridden per deploy with the commit being shipped.
    "CONTAINER_BUILD_ID": ""
  },
  "workers_dev": true,
  "containers": [
    {
      "class_name": "FieldDataContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FIELD_DATA_CONTAINER",
        "class_name": "FieldDataContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FieldDataContainer"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
